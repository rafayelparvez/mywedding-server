# My Wedding server — copy to .env and fill in real values.
# Never commit real secrets; .env is gitignored.

PORT=8000
NODE_ENV=development

# Atlas MongoDB connection string. Required.
# Use your own cluster's connection string here (from Atlas "Connect" > Node.js).
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority

# Public origin of the Next.js frontend.
# Required when NODE_ENV=production; used for CORS.
CLIENT_URL=http://localhost:3000

# Better Auth — used by the server to verify the frontend's JWTs.
# MUST match the Next.js app's BETTER_AUTH_SECRET (mywedding/.env) so the
# server can verify frontend tokens with the same signing keys.
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000
